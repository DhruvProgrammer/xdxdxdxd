# --- WordPress bridge API (optional) ---
# Leave XDMOVIES_API_KEY empty to disable the API entirely. Generate a real
# key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
XDMOVIES_API_KEY=
XDMOVIES_API_HOST=0.0.0.0
XDMOVIES_API_PORT=8090
# Hard cap on download cards resolved per request (0 = unlimited).
XDMOVIES_API_MAX_CARDS=200
# Re-sending the same URL within this window returns the cached result
# instead of re-scraping. 0 disables dedup.
XDMOVIES_API_DEDUP_SECONDS=86400
# Per-IP request ceiling for the API surface.
XDMOVIES_API_RATE_LIMIT=60
# Also DM the owner when a bridge job parks on needs_human (default: silent).
XDMOVIES_API_NOTIFY_OWNER=0
